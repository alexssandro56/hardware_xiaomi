soong_config_module_type {
    name: "sensors_xiaomi_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "SENSORS_XIAOMI",
    bool_variables: [
        "USES_UDFPS_SENSOR",
        "USES_DOUBLE_TAP_SENSOR",
        "DOUBLE_TAP_SENSOR_SKIP_ENABLE",
        "USES_SINGLE_TAP_SENSOR",
    ],
    value_variables: [
        "DOUBLE_TAP_SENSOR_X",
        "DOUBLE_TAP_SENSOR_Y",
    ],
    properties: ["cppflags"],
}

sensors_xiaomi_cc_defaults {
    name: "sensors_xiaomi_defaults",
    soong_config_variables: {
        USES_UDFPS_SENSOR: {
            cppflags: ["-DUSES_UDFPS_SENSOR"],
        },
        USES_DOUBLE_TAP_SENSOR: {
            cppflags: ["-DUSES_DOUBLE_TAP_SENSOR"],
        },
        DOUBLE_TAP_SENSOR_SKIP_ENABLE: {
            cppflags: ["-DDOUBLE_TAP_SENSOR_SKIP_ENABLE"],
        },
        USES_SINGLE_TAP_SENSOR: {
            cppflags: ["-DUSES_SINGLE_TAP_SENSOR"],
        },
        DOUBLE_TAP_SENSOR_X: {
            cppflags: ["-DDOUBLE_TAP_SENSOR_X=%s"],
        },
        DOUBLE_TAP_SENSOR_Y: {
            cppflags: ["-DDOUBLE_TAP_SENSOR_Y=%s"],
        },
    },
}

cc_library_shared {
    name: "sensors.xiaomi",
    defaults: ["hidl_defaults", "sensors_xiaomi_defaults"],
    srcs: [
        "Sensor.cpp",
        "SensorsSubHal.cpp",
    ],
    shared_libs: [
        "android.hardware.sensors@1.0",
        "android.hardware.sensors@2.0",
        "android.hardware.sensors@2.0-ScopedWakelock",
        "android.hardware.sensors@2.1",
        "libcutils",
        "libfmq",
        "libhardware",
        "libhidlbase",
        "liblog",
        "libpower",
        "libutils",
    ],
    static_libs: [
        "android.hardware.sensors@1.0-convert",
        "android.hardware.sensors@2.X-multihal",
    ],
    cflags: [
        "-DLOG_TAG=\"sensors.xiaomi\"",
    ],
    vendor: true,
}
